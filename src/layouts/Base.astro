---
import "../styles/global.css"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { routes, ui, type Locale, type Route } from "../i18n"

interface Props {
  title: string
  description: string
  locale: Locale
  route: Route
  /** A dark header over a dark first section (the commercial management page). */
  dark?: boolean
}
const { title, description, locale, route, dark = false } = Astro.props
const other: Locale = locale === "pt-BR" ? "en" : "pt-BR"
const site = Astro.site ?? new URL("https://ybyata.com")
const canonical = new URL(routes[route][locale], site)
const alternate = new URL(routes[route][other], site)
const t = ui[locale]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {routes[route][locale] !== routes[route][other] && (
      <>
        <link rel="alternate" hreflang={locale} href={canonical} />
        <link rel="alternate" hreflang={other} href={alternate} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f2e7" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale.replace("-", "_")} />
    <meta property="og:image" content={new URL("/og.png", site)} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="grain">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">{t.skip}</a>
    <Header locale={locale} route={route} dark={dark} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} route={route} />
    <script>
      import "../scripts/motion"
    </script>
  </body>
</html>
