---
import Base from "../../layouts/Base.astro"
import HeroJourney from "../HeroJourney.astro"
import Media from "../Media.astro"
import AiReads from "../AiReads.astro"
import { ai } from "../../content/ai"
import { home } from "../../content/home"
import { media, routes, ui, type Locale } from "../../i18n"
import { whatsappLink } from "../../site"

interface Props { locale: Locale }
const { locale } = Astro.props
const c = home[locale]
const a = ai[locale]
const t = ui[locale]
const talk = whatsappLink(t.talkMessage)
---

<Base title={c.title} description={c.description} locale={locale} route="home">
  <!-- Hero -->
  <section class="relative overflow-hidden pb-20 pt-28 sm:pt-36 lg:pb-28">
    <div class="pointer-events-none absolute -right-40 -top-40 size-[640px] rounded-full bg-[radial-gradient(circle,rgba(150,116,31,.14),transparent_65%)]"></div>
    <div class="wrap grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
      <div>
        <p class="eyebrow" data-reveal>{c.hero.eyebrow}</p>
        <h1 class="display mt-5 text-[clamp(2.9rem,7vw,5.6rem)]" data-reveal style="--d: 1">
          {c.hero.title}
          <em class="block font-semibold italic text-carmine">{c.hero.titleEm}</em>
        </h1>
        <p class="mt-7 max-w-[30rem] font-display text-2xl font-semibold leading-snug sm:text-[1.9rem]" data-reveal style="--d: 2">{c.hero.sub}</p>
        <p class="mt-5 max-w-[34rem] text-lg text-ink/70" data-reveal style="--d: 2">{c.hero.lead}</p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--d: 3">
          <a href={talk} class="btn-primary" rel="noopener">{t.talk}</a>
          <a href={routes.platform[locale]} class="btn-ghost">{c.hero.secondary} →</a>
        </div>
      </div>
      <HeroJourney locale={locale} />
    </div>
  </section>

  <!-- Where growth leaks -->
  <section class="border-t border-line py-24 sm:py-32">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{c.leaks.eyebrow}</p>
      <h2 class="display mt-4 max-w-4xl text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">{c.leaks.title}</h2>
      <ol class="mt-16 grid gap-12 md:grid-cols-3 md:gap-10">
        {c.leaks.items.map((item, i) => (
          <li class="border-t border-ink/80 pt-6" data-reveal style={`--d: ${i + 2}`}>
            <span class="font-display text-5xl font-bold text-gold">0{i + 1}</span>
            <h3 class="mt-4 font-display text-2xl font-bold leading-tight">{item.title}</h3>
            <p class="mt-3 text-ink/75">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- The AI, at work -->
  <section class="relative overflow-hidden border-t border-line py-24 sm:py-32">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-20">
      <div>
        <p class="eyebrow" data-reveal>✦ {a.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">
          {a.title} <em class="block font-semibold italic text-carmine">{a.titleEm}</em>
        </h2>
        <p class="mt-6 max-w-xl text-lg text-ink/75" data-reveal style="--d: 2">{a.lead}</p>
      </div>
      <AiReads locale={locale} />
    </div>
    <div class="wrap mt-20">
      <ol class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {a.capabilities.map((cap, i) => (
          <li class="border-t border-ink/80 pt-5" data-reveal style={`--d: ${(i % 3) + 1}`}>
            <h3 class="font-display text-2xl font-bold"><span class="mr-2 text-gold">✦</span>{cap.title}</h3>
            <p class="mt-2 text-ink/75">{cap.body}</p>
          </li>
        ))}
      </ol>
      <p class="mt-12 flex flex-wrap gap-x-8 gap-y-2 font-mono text-[0.8rem] text-muted-ink" data-reveal>
        {a.promise.map((p) => <span>— {p}</span>)}
      </p>
    </div>
  </section>

  <!-- Two offers -->
  <section class="border-t border-line bg-card/60 py-24 sm:py-32">
    <div class="wrap">
      <div class="max-w-3xl">
        <p class="eyebrow" data-reveal>{c.offers.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">{c.offers.title}</h2>
      </div>
      <div class="mt-14 grid gap-6 lg:grid-cols-2">
        {[
          { o: c.offers.platform, href: routes.platform[locale], tone: "bg-paper text-ink", rule: "bg-carmine" },
          { o: c.offers.service, href: routes.service[locale], tone: "bg-night text-night-ink", rule: "bg-gold" },
        ].map(({ o, href, tone, rule }, i) => (
          <a href={href} class:list={["group relative flex flex-col overflow-hidden rounded-3xl border border-line p-8 transition-transform duration-500 hover:-translate-y-1 sm:p-10", tone]} data-reveal style={`--d: ${i + 2}`}>
            <span class:list={["h-1 w-12 rounded-full", rule]}></span>
            <p class="eyebrow mt-6 !text-current opacity-60">{o.name}</p>
            <h3 class="display mt-3 text-4xl sm:text-5xl">{o.title}</h3>
            <ul class="mt-8 space-y-3">
              {o.points.map((p) => (
                <li class="flex gap-3"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-current opacity-50"></span><span class="opacity-85">{p}</span></li>
              ))}
            </ul>
            <span class="mt-10 inline-flex items-center gap-2 font-bold">{o.cta} <span class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works: the steps advance while the product stays in view -->
  <section class="border-t border-line py-24 sm:py-32" data-steps>
    <div class="wrap">
      <p class="eyebrow" data-reveal>{c.steps.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">{c.steps.title}</h2>
      <div class="mt-14 grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <ol class="relative space-y-10 lg:space-y-[38vh] lg:py-[18vh]">
          <span class="absolute left-[1.35rem] top-0 hidden h-full w-px bg-line lg:block"></span>
          <span class="absolute left-[1.35rem] top-0 hidden w-px origin-top bg-carmine transition-[height] duration-700 lg:block" style="height: calc(var(--progress, 0) * 100%)"></span>
          {c.steps.items.map((s) => (
            <li class="step relative lg:pl-16" data-step>
              <span class="step-n mb-3 flex size-11 items-center justify-center rounded-full border border-line bg-paper font-display text-lg font-bold transition-colors duration-500 lg:absolute lg:left-0 lg:top-0 lg:mb-0">{s.n}</span>
              <h3 class="font-display text-3xl font-bold leading-tight">{s.title}</h3>
              <p class="mt-3 max-w-md text-ink/75">{s.body}</p>
              <div class="mt-6 lg:hidden">
                <Media locale={locale} alt={s.media.alt} image={s.media.image} clip={s.media.clip} width={s.media.w} height={s.media.h} />
              </div>
            </li>
          ))}
        </ol>
        <div class="hidden lg:block">
          <div class="sticky top-[14vh]">
            <div class="relative">
              {c.steps.items.map((s, i) => (
                <div class:list={["pane", i === 0 ? "relative" : "absolute inset-x-0 top-0"]} data-pane>
                  <Media locale={locale} alt={s.media.alt} image={s.media.image} clip={s.media.clip} width={s.media.w} height={s.media.h} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The platform, passing sideways -->
  <section class="relative overflow-x-clip border-t border-line bg-night text-night-ink lg:h-[300vh]" data-hscroll>
    <div class="lg:sticky lg:top-0 lg:flex lg:h-screen lg:flex-col lg:justify-center">
      <div class="wrap pt-24 lg:pt-10">
        <p class="eyebrow !text-night-muted">{c.strip.eyebrow}</p>
        <h2 class="display mt-4 max-w-3xl text-[clamp(2.1rem,4.6vw,3.6rem)]">{c.strip.title}</h2>
      </div>
      <div class="mt-12 overflow-x-auto pb-6 lg:overflow-visible lg:pb-0 [scrollbar-width:none]">
        <div class="flex w-max snap-x snap-mandatory gap-6 px-4 sm:px-6 lg:px-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))]" data-track>
          {c.strip.items.map((item) => (
            <article class="w-[80vw] shrink-0 snap-start sm:w-[520px]">
              <div class="overflow-hidden rounded-2xl border border-white/10 bg-card shadow-2xl">
                <img src={media(item.image, locale)} alt="" class="block aspect-[16/10] w-full object-cover object-top" loading="lazy" decoding="async" />
              </div>
              <h3 class="mt-5 font-display text-2xl font-bold">{item.title}</h3>
              <p class="mt-1.5 max-w-md text-night-muted">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="wrap pb-24 pt-8 lg:pb-10">
        <p class="max-w-3xl text-night-muted">{c.strip.more}</p>
        <div class="mt-5 h-px w-full bg-white/10"><div class="h-px bg-gold" style="width: calc(var(--p, 0) * 100%)"></div></div>
      </div>
    </div>
  </section>

  <!-- Commercial management -->
  <section class="relative overflow-hidden border-t border-line py-24 sm:py-32">
    <div class="wrap grid gap-14 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div>
        <p class="eyebrow" data-reveal>{c.service.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">{c.service.title}</h2>
        <p class="mt-6 max-w-xl text-lg text-ink/75" data-reveal style="--d: 2">{c.service.body}</p>
        <a href={routes.service[locale]} class="btn-ghost mt-9" data-reveal style="--d: 3">{c.service.cta} →</a>
      </div>
      <dl class="grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2">
        {c.service.points.map(([verb, what], i) => (
          <div class="bg-paper p-7" data-reveal style={`--d: ${i + 2}`}>
            <dt class="font-display text-3xl font-bold italic text-carmine">{verb}</dt>
            <dd class="mt-2 text-ink/75">{what}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Privacy -->
  <section class="border-t border-line bg-card/60 py-24 sm:py-28">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow" data-reveal>{c.trust.eyebrow}</p>
          <h2 class="display mt-4 max-w-2xl text-[clamp(2rem,4vw,3.2rem)]" data-reveal style="--d: 1">{c.trust.title}</h2>
        </div>
        <p class="font-mono text-xs text-muted-ink" data-reveal style="--d: 2">−23.55, −46.63 · southamerica-east1</p>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {c.trust.items.map((item, i) => (
          <div data-reveal style={`--d: ${i + 2}`}>
            <h3 class="font-display text-2xl font-bold">{item.title}</h3>
            <p class="mt-2 text-ink/75">{item.body}</p>
          </div>
        ))}
      </div>
      <a href={routes.privacy[locale]} class="mt-10 inline-block font-bold text-carmine underline underline-offset-4">{c.trust.link}</a>
    </div>
  </section>

  <!-- Roadmap -->
  <section class="border-t border-line py-24 sm:py-28">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{c.roadmap.eyebrow}</p>
      <h2 class="display mt-4 max-w-3xl text-[clamp(2rem,4vw,3.2rem)]" data-reveal style="--d: 1">{c.roadmap.title}</h2>
      <ol class="relative mt-14 grid gap-10 md:grid-cols-3">
        <span class="absolute left-0 right-0 top-[7px] hidden h-px bg-[repeating-linear-gradient(90deg,var(--color-line)_0_8px,transparent_8px_14px)] md:block"></span>
        {c.roadmap.items.map((item, i) => (
          <li class="relative" data-reveal style={`--d: ${i + 2}`}>
            <span class="relative block size-[15px] rounded-full border-2 border-gold bg-paper"></span>
            <p class="eyebrow mt-5 !text-gold">{t.soon}</p>
            <h3 class="mt-2 font-display text-2xl font-bold">{item.title}</h3>
            <p class="mt-2 text-ink/75">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Final call -->
  <section class="relative overflow-hidden bg-night py-28 text-night-ink sm:py-36">
    <div class="pointer-events-none absolute -right-24 top-1/2 w-[560px] -translate-y-1/2 text-gold/25" data-parallax="-0.12">
      <svg viewBox="-48 -48 1120 1120" fill="none" class="w-full" data-draw style="--len: 5200">
        <path stroke="currentColor" stroke-width="4" d="M514.05 100.35 L403.31 211.09 L403.31 317.29 L299.01 212.99 L512 0 L737.28 225.28 L688.13 274.43 Z M432.27 223.09 L514.05 141.31 L882.69 509.95 L739.33 653.31 L692.22 606.21 L786.43 512 L512 237.57 L432.27 317.29 Z M284.67 329.73 L100.35 514.05 L315.39 729.09 L266.24 778.24 L0 512 L278.53 233.47 L467.97 422.91 L422.91 467.97 Z" />
      </svg>
    </div>
    <div class="wrap relative">
      <h2 class="display max-w-3xl text-[clamp(2.6rem,6vw,4.8rem)]" data-reveal>{c.final.title}</h2>
      <p class="mt-6 max-w-xl text-lg text-night-muted" data-reveal style="--d: 1">{c.final.body}</p>
      <div class="mt-10 flex flex-wrap items-center gap-5" data-reveal style="--d: 2">
        <a href={talk} class="btn-light" rel="noopener">{t.talk}</a>
        <span class="text-sm text-night-muted">{c.final.note}</span>
      </div>
    </div>
  </section>
</Base>

<style>
  [data-step] .step-n { color: var(--color-muted-ink); }
  [data-step].is-active .step-n { background: var(--color-carmine); border-color: var(--color-carmine); color: var(--color-card); }
  @media (min-width: 1024px) {
    [data-step] { opacity: 0.35; transition: opacity .5s; }
    [data-step].is-active { opacity: 1; }
    .pane { opacity: 0; transform: translateY(16px) scale(.985); transition: opacity .6s, transform .6s; }
    .pane.is-active { opacity: 1; transform: none; }
  }
</style>
