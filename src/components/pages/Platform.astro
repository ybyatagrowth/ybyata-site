---
import Base from "../../layouts/Base.astro"
import Media from "../Media.astro"
import AiReads from "../AiReads.astro"
import { ai } from "../../content/ai"
import { platform } from "../../content/platform"
import { routes, ui, type Locale } from "../../i18n"
import { whatsappLink } from "../../site"

interface Props { locale: Locale }
const { locale } = Astro.props
const c = platform[locale]
const a = ai[locale]
const t = ui[locale]
const talk = whatsappLink(t.talkMessage)
---

<Base title={c.title} description={c.description} locale={locale} route="platform">
  <section class="relative overflow-hidden pb-16 pt-28 sm:pt-36">
    <div class="wrap text-center">
      <p class="eyebrow" data-reveal>{c.hero.eyebrow}</p>
      <h1 class="display mx-auto mt-5 max-w-5xl text-[clamp(2.7rem,6.4vw,5.2rem)]" data-reveal style="--d: 1">
        {c.hero.title}
        <em class="block font-semibold italic text-carmine">{c.hero.titleEm}</em>
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-lg text-ink/75 sm:text-xl" data-reveal style="--d: 2">{c.hero.lead}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3" data-reveal style="--d: 3">
        <a href={talk} class="btn-primary" rel="noopener">{t.talk}</a>
      </div>
    </div>
    <div class="wrap mt-16 [perspective:1600px]">
      <div class="hero-tilt mx-auto max-w-5xl" data-reveal style="--d: 4">
        <Media locale={locale} alt={c.hero.media.alt} clip={c.hero.media.clip} width={c.hero.media.w} height={c.hero.media.h} caption={t.demoData} eager />
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-night py-24 text-night-ink sm:py-32">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-20">
      <div>
        <p class="eyebrow !text-night-muted" data-reveal>✦ {a.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">
          {a.title} <em class="block font-semibold italic text-gold">{a.titleEm}</em>
        </h2>
        <p class="mt-6 max-w-xl text-lg text-night-muted" data-reveal style="--d: 2">{a.lead}</p>
        <p class="mt-8 flex flex-col gap-1 font-mono text-[0.8rem] text-night-muted" data-reveal style="--d: 3">
          {a.promise.map((p) => <span>— {p}</span>)}
        </p>
      </div>
      <AiReads locale={locale} />
    </div>
    <div class="wrap mt-20">
      <ol class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {a.capabilities.map((cap, i) => (
          <li class="border-t border-white/25 pt-5" data-reveal style={`--d: ${(i % 3) + 1}`}>
            <h3 class="font-display text-2xl font-bold"><span class="mr-2 text-gold">✦</span>{cap.title}</h3>
            <p class="mt-2 text-night-muted">{cap.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {c.features.map((f, i) => (
    <section class="border-t border-line py-20 sm:py-28">
      <div class:list={["wrap grid items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20", i % 2 === 1 && "lg:grid-cols-[1.15fr_0.85fr]"]}>
        <div class:list={[i % 2 === 1 && "lg:order-2"]}>
          <p class="eyebrow flex items-center gap-3" data-reveal>{f.eyebrow}{"ai" in f && f.ai && <span class="rounded-full border border-gold/60 px-2 py-0.5 !tracking-[0.1em] text-gold">✦ {locale === "pt-BR" ? "IA" : "AI"}</span>}</p>
          <h2 class="display mt-4 text-[clamp(2rem,4.2vw,3.3rem)]" data-reveal style="--d: 1">{f.title}</h2>
          <p class="mt-5 max-w-lg text-lg text-ink/75" data-reveal style="--d: 2">{f.body}</p>
        </div>
        <div class:list={[i % 2 === 1 && "lg:order-1"]}>
          <div data-parallax={i % 2 ? "-0.05" : "0.05"}>
            <div data-reveal style="--d: 2">
              <Media locale={locale} alt={f.media.alt} image={f.media.image} clip={f.media.clip} width={f.media.w} height={f.media.h} />
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="border-t border-line bg-card/60 py-20 sm:py-28">
    <div class="wrap">
      <h2 class="display text-[clamp(2rem,4vw,3.2rem)]" data-reveal>{c.more.title}</h2>
      <dl class="mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
        {c.more.items.map(([name, what, isAi], i) => (
          <div class="border-t border-ink/70 pt-4" data-reveal style={`--d: ${(i % 4) + 1}`}>
            <dt class="font-display text-2xl font-bold">{isAi && <span class="mr-2 text-gold">✦</span>}{name}</dt>
            <dd class="mt-2 text-ink/75">{what}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="border-t border-line bg-night py-24 text-night-ink sm:py-32">
    <div class="wrap">
      <p class="eyebrow !text-night-muted" data-reveal>{c.ads.eyebrow}</p>
      <h2 class="display mt-4 max-w-3xl text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">{c.ads.title}</h2>
      <div class="mt-14 grid gap-12 lg:grid-cols-2">
        <div data-reveal style="--d: 2">
          <h3 class="font-display text-2xl font-bold">{c.ads.model.title}</h3>
          <p class="mt-3 text-night-muted">{c.ads.model.body}</p>
          <a href={routes.googleAds[locale]} lang="en" class="mt-6 inline-block font-bold text-gold underline underline-offset-4">{c.ads.doc} →</a>
        </div>
        <div data-reveal style="--d: 3">
          <h3 class="font-display text-2xl font-bold">{c.ads.does.title}</h3>
          <ul class="mt-3 space-y-3">
            {c.ads.does.items.map((item) => (
              <li class="flex gap-3 text-night-muted"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-gold"></span>{item}</li>
            ))}
          </ul>
        </div>
      </div>
      <h3 class="mt-16 font-display text-2xl font-bold" data-reveal>{c.ads.whoTitle}</h3>
      <div class="mt-5 overflow-x-auto" data-reveal style="--d: 1">
        <table class="w-full min-w-[560px] border-collapse text-left">
          <thead>
            <tr>{c.ads.who.head.map((h) => <th class="eyebrow border-b border-white/15 py-3 pr-6 !text-night-muted">{h}</th>)}</tr>
          </thead>
          <tbody>
            {c.ads.who.rows.map((row) => (
              <tr>{row.map((cell, i) => <td class:list={["border-b border-white/10 py-4 pr-6 align-top", i === 0 ? "font-bold" : "text-night-muted"]}>{cell}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="py-24 sm:py-28">
    <div class="wrap flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="display max-w-2xl text-[clamp(2rem,4.4vw,3.4rem)]" data-reveal>
        {locale === "pt-BR" ? "Quer ver a plataforma com os números da sua clínica?" : "Want to see the platform with your clinic's numbers?"}
      </h2>
      <a href={talk} class="btn-primary shrink-0" rel="noopener" data-reveal style="--d: 1">{t.talk}</a>
    </div>
  </section>
</Base>

<style>
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .hero-tilt { transform: rotateX(10deg) scale(.96); transform-origin: 50% 0; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
    .hero-tilt.is-in { transform: rotateX(0) scale(1); }
  }
</style>
