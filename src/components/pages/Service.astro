---
import Base from "../../layouts/Base.astro"
import Media from "../Media.astro"
import { results, service, testimonials } from "../../content/service"
import { routes, ui, type Locale } from "../../i18n"
import { whatsappLink } from "../../site"

interface Props { locale: Locale }
const { locale } = Astro.props
const c = service[locale]
const t = ui[locale]
const talk = whatsappLink(t.talkMessage)
const showResults = testimonials.length > 0 || results.length > 0
---

<Base title={c.title} description={c.description} locale={locale} route="service" dark>
  <section class="relative overflow-hidden bg-night pb-24 pt-32 text-night-ink sm:pb-32 sm:pt-44">
    <div class="pointer-events-none absolute -left-40 top-10 size-[620px] rounded-full bg-[radial-gradient(circle,rgba(150,116,31,.22),transparent_65%)]" data-parallax="0.15"></div>
    <div class="wrap relative">
      <p class="eyebrow !text-night-muted" data-reveal>{c.hero.eyebrow}</p>
      <h1 class="display mt-5 max-w-5xl text-[clamp(2.7rem,6.6vw,5.4rem)]" data-reveal style="--d: 1">
        {c.hero.title}
        <em class="block font-semibold italic text-gold">{c.hero.titleEm}</em>
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-night-muted sm:text-xl" data-reveal style="--d: 2">{c.hero.lead}</p>
      <a href={talk} class="btn-light mt-10" rel="noopener" data-reveal style="--d: 3">{t.talk}</a>
    </div>
  </section>

  <section class="py-24 sm:py-32">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{c.what.eyebrow}</p>
      <h2 class="display mt-4 max-w-3xl text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">{c.what.title}</h2>
      <ol class="mt-16 grid gap-x-12 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {c.what.items.map((item, i) => (
          <li data-reveal style={`--d: ${(i % 3) + 1}`}>
            <div class="flex items-baseline gap-4 border-b border-ink/80 pb-4">
              <span class="font-display text-4xl font-bold italic text-gold">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="font-display text-2xl font-bold">{item.title}</h3>
            </div>
            <p class="mt-4 text-ink/75">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-t border-line bg-card/60 py-24 sm:py-32">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{c.rhythm.eyebrow}</p>
      <h2 class="display mt-4 max-w-3xl text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">{c.rhythm.title}</h2>
      <div class="relative mt-16">
        <svg class="pointer-events-none absolute left-0 top-[26px] hidden h-4 w-full lg:block" viewBox="0 0 1000 16" preserveAspectRatio="none" data-draw style="--len: 1000">
          <line x1="0" y1="8" x2="1000" y2="8" stroke="var(--color-gold)" stroke-width="2" stroke-dasharray="1000" vector-effect="non-scaling-stroke" />
        </svg>
        <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          {c.rhythm.items.map((r, i) => (
            <li class="relative" data-reveal style={`--d: ${i + 2}`}>
              <span class="relative z-10 flex size-[54px] items-center justify-center rounded-full border-2 border-gold bg-paper font-display text-xl font-bold italic text-gold">{i + 1}</span>
              <h3 class="mt-5 font-display text-3xl font-bold">{r.when}</h3>
              <ul class="mt-3 space-y-1.5 text-ink/75">
                {r.what.map((w) => <li>{w}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {showResults && (
    <section class="overflow-hidden border-t border-line bg-card/60 py-24 sm:py-32">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{c.results.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2.1rem,4.6vw,3.6rem)]" data-reveal style="--d: 1">{c.results.title}</h2>
        {results.length > 0 && (
          <div class="mt-14 grid gap-8 md:grid-cols-3">
            {results.map((r, i) => (
              <div class="border-t border-ink/80 pt-5" data-reveal style={`--d: ${i + 1}`}>
                <p class="font-display text-5xl font-bold">{r.before} <span class="text-gold">→</span> {r.after}</p>
                <p class="mt-2 text-ink/75">{r.what[locale]}</p>
                <p class="mt-1 text-sm text-muted-ink">{r.clinic}</p>
              </div>
            ))}
          </div>
        )}
        {testimonials.length > 0 && (
          <div class="pile relative mt-16 flex flex-wrap justify-center gap-6 lg:block lg:h-[640px]" data-spread>
            {testimonials.map((m, i) => (
              <figure class="pile-item w-[260px] lg:absolute lg:left-1/2 lg:top-0" style={`--i: ${i}; --n: ${testimonials.length}`}>
                <img src={m.image} alt={m.alt} class="w-full rounded-2xl border border-line shadow-xl" loading="lazy" />
                <figcaption class="mt-2 text-center text-sm text-muted-ink">{m.clinic}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <section class="border-t border-line py-24 sm:py-32">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow" data-reveal>{c.together.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2rem,4.2vw,3.3rem)]" data-reveal style="--d: 1">{c.together.title}</h2>
        <p class="mt-5 max-w-lg text-lg text-ink/75" data-reveal style="--d: 2">{c.together.body}</p>
        <a href={routes.platform[locale]} class="btn-ghost mt-8" data-reveal style="--d: 3">{c.together.link} →</a>
      </div>
      <div data-parallax="0.06">
        <div data-reveal style="--d: 2">
          <Media image="/media/home.png" width={1168} height={900} alt={locale === "pt-BR" ? "O início da plataforma: custo por agendamento, leads, agendados, comparecimentos e receita." : "The platform's home: cost per booking, leads, bookings, visits and revenue."} />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-night py-24 text-night-ink sm:py-32">
    <div class="wrap">
      <h2 class="display max-w-3xl text-[clamp(2.4rem,5.6vw,4.4rem)]" data-reveal>{c.final.title}</h2>
      <p class="mt-6 max-w-xl text-lg text-night-muted" data-reveal style="--d: 1">{c.final.body}</p>
      <a href={talk} class="btn-light mt-10" rel="noopener" data-reveal style="--d: 2">{t.talk}</a>
    </div>
  </section>
</Base>

<style>
  /* The testimonials start stacked like photos on a table and spread out as the section scrolls in. */
  @media (min-width: 1024px) {
    .pile-item {
      --x: calc((var(--i) - (var(--n) - 1) / 2) * 280px * var(--spread, 1));
      --r: calc((var(--i) - (var(--n) - 1) / 2) * 4deg * (1 - var(--spread, 1) * 0.6));
      translate: calc(-50% + var(--x)) calc(var(--i) * 6px * (1 - var(--spread, 1)));
      rotate: var(--r);
      transition: translate .2s linear, rotate .2s linear;
    }
  }
</style>
