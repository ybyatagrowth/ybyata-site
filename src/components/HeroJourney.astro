---
// The hero's picture: a patient's journey told with the product's own pieces. An ad is clicked,
// the conversation happens on WhatsApp, the platform proposes what happened, and the report shows
// what the booking cost. Built in HTML, not a screenshot, so it stays sharp and can move.
import type { Locale } from "../i18n"

interface Props { locale: Locale }
const { locale } = Astro.props
const c = {
  "pt-BR": {
    sponsored: "Patrocinado · Google",
    adTitle: "Fisioterapia em Pinheiros",
    adBody: "Avaliação com fisioterapeuta esta semana. Agende pelo WhatsApp.",
    clickId: "gclid registrado",
    chatWith: "WhatsApp da clínica",
    lead1: "Oi! Vi o anúncio. Vocês têm horário essa semana?",
    desk: "Temos quinta às 15h ou sexta às 10h 🙂",
    lead2: "Quinta às 15h, por favor!",
    proposed: "IA da Ybyatã",
    scheduled: "Agendou",
    when: "Quinta, 15h · avaliação",
    sure: "94% de certeza",
    approve: "Aprovar",
    costLabel: "Custo por agendamento",
    campaign: "Google · Fisioterapia · Busca",
    bookings: "5 leads · 3 agendados",
  },
  en: {
    sponsored: "Sponsored · Google",
    adTitle: "Physiotherapy in Pinheiros",
    adBody: "An assessment with a physiotherapist this week. Book on WhatsApp.",
    clickId: "gclid recorded",
    chatWith: "The clinic's WhatsApp",
    lead1: "Hi! I saw the ad. Do you have any time this week?",
    desk: "We have Thursday at 3 pm or Friday at 10 am 🙂",
    lead2: "Thursday at 3 pm, please!",
    proposed: "Ybyatã AI",
    scheduled: "Scheduled",
    when: "Thursday, 3 pm · assessment",
    sure: "94% sure",
    approve: "Approve",
    costLabel: "Cost per booking",
    campaign: "Google · Physiotherapy · Search",
    bookings: "5 leads · 3 booked",
  },
}[locale]
const card = "rounded-2xl border border-line bg-card/95 p-4 shadow-[0_18px_50px_-20px_rgba(38,32,25,.35)] backdrop-blur"
---

<div class="relative mx-auto w-full max-w-[560px] lg:h-[680px]" aria-hidden="true">
  <svg class="pointer-events-none absolute inset-0 hidden h-full w-full lg:block" viewBox="0 0 560 680" fill="none" data-draw style="--len: 1400">
    <path d="M150 150 C 300 110, 380 150, 400 220 S 280 330, 180 380 S 260 520, 400 540" stroke="var(--color-carmine)" stroke-width="1.6" stroke-dasharray="1400" stroke-linecap="round" />
    <circle cx="150" cy="150" r="5" fill="var(--color-carmine)" />
    <circle cx="400" cy="540" r="5" fill="var(--color-carmine)" />
  </svg>

  <div class="relative flex flex-col gap-3 lg:block">
    <div class="lg:absolute lg:left-0 lg:top-0 lg:w-[270px]" data-parallax="0.04">
      <div class:list={[card, "lg:-rotate-2"]} data-reveal style="--d: 1">
        <p class="text-[0.7rem] font-bold text-muted-ink">{c.sponsored}</p>
        <p class="mt-1 font-bold text-ad-link">{c.adTitle}</p>
        <p class="mt-1 text-sm leading-snug text-ink/80">{c.adBody}</p>
        <p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-muted px-2.5 py-0.5 font-mono text-[0.68rem] text-muted-ink"><span class="size-1.5 rounded-full bg-moss"></span>{c.clickId}</p>
      </div>
    </div>

    <div class="lg:absolute lg:right-0 lg:top-[80px] lg:w-[300px]" data-parallax="-0.03">
      <div class:list={[card, "bg-chat/95"]} data-reveal style="--d: 3">
        <p class="mb-2.5 text-[0.7rem] font-bold text-muted-ink">{c.chatWith}</p>
        <div class="space-y-2 text-[0.85rem] leading-snug">
          <p class="mr-8 rounded-xl rounded-tl-sm bg-card px-3 py-2 shadow-sm">{c.lead1}</p>
          <p class="ml-8 rounded-xl rounded-tr-sm bg-chat-out px-3 py-2 shadow-sm">{c.desk}</p>
          <p class="mr-12 rounded-xl rounded-tl-sm bg-card px-3 py-2 shadow-sm ring-1 ring-carmine/40">{c.lead2}</p>
        </div>
      </div>
    </div>

    <div class="lg:absolute lg:left-2 lg:top-[330px] lg:w-[280px]" data-parallax="0.05">
      <div class:list={[card, "lg:rotate-1"]} data-reveal style="--d: 5">
        <div class="flex items-center justify-between gap-2">
          <p class="text-[0.7rem] font-bold text-muted-ink">✦ {c.proposed}</p>
          <span class="rounded-full border border-line px-2 py-0.5 text-[0.7rem] font-bold">{c.scheduled}</span>
        </div>
        <p class="mt-2 font-display text-2xl font-bold">{c.when}</p>
        <div class="mt-3 flex items-center justify-between">
          <span class="font-mono text-[0.72rem] text-muted-ink">{c.sure}</span>
          <span class="rounded-full bg-carmine px-3.5 py-1 text-[0.8rem] font-bold text-card">✓ {c.approve}</span>
        </div>
      </div>
    </div>

    <div class="lg:absolute lg:right-0 lg:top-[490px] lg:w-[290px]" data-parallax="-0.04">
      <div class={card} data-reveal style="--d: 7">
        <p class="eyebrow !text-[0.66rem]">{c.costLabel}</p>
        <p class="mt-1 font-display text-5xl font-bold leading-none"><span data-count="191.64" data-decimals="2" data-prefix="R$ ">R$ 191,64</span></p>
        <div class="mt-3 flex h-10 items-end gap-1">
          {[40, 62, 48, 70, 55, 82, 64, 90, 76].map((h, i) => (
            <span class="flex-1 rounded-sm bg-moss/80" style={`height:${h}%; opacity:${0.45 + i * 0.06}`}></span>
          ))}
        </div>
        <p class="mt-2 text-[0.75rem] text-muted-ink">{c.campaign} · {c.bookings}</p>
      </div>
    </div>
  </div>
</div>
