---
// A piece of the product, in a quiet frame with the app's address on top: a screenshot, or a
// short clip that plays while on screen (its poster stands in until then, and for reduced motion).
interface Props {
  alt: string
  image?: string
  clip?: string
  width?: number
  height?: number
  caption?: string
  class?: string
  eager?: boolean
}
const { alt, image, clip, width, height, caption, class: className = "", eager = false } = Astro.props
---

<figure class:list={["group", className]}>
  <div class="overflow-hidden rounded-2xl border border-line bg-card shadow-[0_1px_0_rgba(255,255,255,.6)_inset,0_24px_60px_-24px_rgba(38,32,25,.35)]">
    <div class="flex items-center gap-2 border-b border-line/80 px-4 py-2.5">
      <span class="size-2 rounded-full bg-carmine/70"></span>
      <span class="font-mono text-[0.7rem] text-muted-ink">app.ybyata.com</span>
    </div>
    {clip ? (
      <video
        data-clip
        class="block h-auto w-full"
        muted
        loop
        playsinline
        preload="none"
        poster={`/media/${clip}-poster.png`}
        width={width}
        height={height}
        aria-label={alt}
      >
        <source src={`/media/${clip}.webm`} type="video/webm" />
        <source src={`/media/${clip}.mp4`} type="video/mp4" />
      </video>
    ) : (
      <img class="block h-auto w-full" src={image} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} decoding="async" />
    )}
  </div>
  {caption && <figcaption class="mt-3 text-sm text-muted-ink">{caption}</figcaption>}
</figure>
